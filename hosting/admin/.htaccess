# Madar Al-Huda admin: only index.php is a public entry point.
Options -Indexes

# The ChatGPT connector: /admin/mcp/<secret> → index.php?mcp=<secret>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^fiqh/sitemap\.xml$ index.php?fiqh_page=sitemap [L]
    RewriteRule ^fiqh/(ar|en)/?$ index.php?fiqh_page=$1 [L]
    RewriteRule ^fiqh/(ar|en)/([a-z0-9][a-z0-9_-]{0,95})/?$ index.php?fiqh_page=$1&fiqh_slug=$2 [L]
    RewriteRule ^mcp/([0-9a-fA-F]{64})/?$ index.php?mcp=$1 [L,QSA]
</IfModule>

<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
