<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/prayer_status_place"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/prayer_status_next"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        <Chronometer android:id="@+id/prayer_status_countdown"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/prayer_status_last"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        <Chronometer android:id="@+id/prayer_status_elapsed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
</LinearLayout>
